name: 'Multi-Folder Mend Scan'

on:
  workflow_dispatch:

jobs:
  mend-scan:
    runs-on: ubuntu-latest
    steps:
      - name: 'Checkout'
        uses: actions/checkout@v4
{% if folders %}{% for entry in folders.split(',') if entry.strip() %}{% set parts = entry.strip().split(':') %}{% set folder = parts[0].strip() %}{% set lang = parts[1].strip() %}
      - name: 'Setup and Build for {{ folder }} ({{ lang }})'
        run: |
{% if lang == "python" %}
          echo "Setting up Python in {{ folder }}"
          python -m pip install -r {{ folder }}/requirements.txt
{% elif lang == "java" %}
          echo "Building Java in {{ folder }}"
          cd {{ folder }} && mvn clean install
{% elif lang == "go" %}
          echo "Compiling Go in {{ folder }}"
          cd {{ folder }} && go build .
{% else %}
          echo "No setup defined for {{ lang }}"
{% endif %}
      - name: 'Run Mend SCA Scan - {{ folder }}'
        run: |
          echo "Scanning folder {{ folder }} SCA"
      - name: 'Run Mend SAST Scan - {{ folder }}'
        run: |
          echo "SAST"
{% endfor %}
{% else %}
      - name: 'No folders provided'
        run: echo "No folder input was provided."
{% endif %}
