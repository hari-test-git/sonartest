name: 'Test Folder Strip with Loop'

on:
  workflow_dispatch:

jobs:
  folder-loop-test:
    runs-on: ubuntu-latest

    steps:
      - name: 'Checkout'
        uses: actions/checkout@v4


{% if folders %}
{% for folder in folders.split(',') if folder.strip() %}
      - name: 'Echo folder name: {{ folder.strip() }}'
        run: |
          echo "Folder being processed: {{ folder.strip() }}"
{% endfor %}
{% else %}
      - name: 'No folders provided'
        run: echo "No folder input was provided."
{% endif %}
